# ==============================================================================
# SPECTER PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure for your local node.
# NEVER commit your real .env or secrets to version control.
# ==============================================================================

# Core Gateway Configuration
SPECTER_HOST=127.0.0.1
SPECTER_PORT=8888
SPECTER_API_KEY=your_specter_api_key_here

# Persistence & Storage (Defaults to repository directory or ~/.specter)
# SPECTER_ROOT=~/.specter
# SPECTER_CORE_DIR=./Core
# SPECTER_STORAGE_DIR=./Core/storage
# SPECTER_DB_PATH=./Core/storage/specter_fabric.sqlite3

# Public Tunnel Integration (Ngrok / Cloudflare / Custom Reverse Proxy)
# Set your public tunnel URL here or let the daemon write to public_tunnel_url.txt
SPECTER_TUNNEL_URL=https://your-named-tunnel.ngrok-free.dev
# NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Operator Identity
SPECTER_OPERATOR=Guilherme Peralta Novaes

# Upstream LLM Providers (Optional for hybrid fallback)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
